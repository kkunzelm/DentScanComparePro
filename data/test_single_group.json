{
  "study": {
    "name": "Test_Single_Group_SKD20",
    "version": 1,
    "reference_strategy": "gpa_mean",
    "alignment": {
      "max_icp_iterations": 50,
      "convergence_threshold_mm": 0.05,
      "use_pca_coarse": true,
      "use_4orientation_test": true
    }
  },
  "scanners": [
    {
      "id": "Primescan",
      "patterns": ["*Primescan*"]
    }
  ],
  "groups": [
    {
      "id": "SKD_20",
      "skd_mm": 20,
      "file_patterns": [
        "**/SKD 20/*.stl",
        "**/20mm/*.stl"
      ],
      "roi": {
        "z_plane": {
          "active": true,
          "above_mm": 2.0,
          "below_mm": 12.0
        },
        "outlier_sigma": 3.0
      }
    }
  ],
  "output": {
    "base_dir": "./results",
    "metrics_csv": "test_metrics.csv",
    "summary_csv": "test_summary.csv",
    "precision_csv": "test_precision.csv"
  }
}
