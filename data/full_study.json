{
  "study": {
    "name": "Full_Scanner_Comparison_2024",
    "version": 1,
    "description": "Complete comparison of 6 intraoral scanners across 7 SKD levels (inter-incisor distances)",
    "reference_strategy": "gpa_mean",
    "alignment": {
      "max_icp_iterations": 100,
      "convergence_threshold_mm": 0.01,
      "use_pca_coarse": true,
      "use_4orientation_test": true
    }
  },
  "scanners": [
    {
      "id": "Primescan",
      "patterns": ["*Primescan*"]
    },
    {
      "id": "Trios4",
      "patterns": ["*Trios 4*", "*Trios4*"]
    },
    {
      "id": "Trios5",
      "patterns": ["*Trios 5*", "*Trios5*"]
    },
    {
      "id": "Medit_i700",
      "patterns": ["*Medit i700*", "*Mediti700*", "*Medit*i700*"]
    },
    {
      "id": "iTeroLumina",
      "patterns": ["*iTeroLumina*", "*iTero*Lumina*"]
    },
    {
      "id": "FussenS6000",
      "patterns": ["*Fussen S6000*", "*FussenS6000*", "*Fussen*S6000*"]
    }
  ],
  "groups": [
    {
      "id": "SKD_18",
      "skd_mm": 18,
      "file_patterns": [
        "**/SKD 18/*.stl",
        "**/SKD 18/**/*.stl"
      ],
      "roi": {
        "z_plane": {
          "active": false,
          "above_mm": 2.0,
          "below_mm": 12.0
        },
        "outlier_sigma": 3.0
      }
    },
    {
      "id": "SKD_20",
      "skd_mm": 20,
      "file_patterns": [
        "**/SKD 20/*.stl",
        "**/SKD 20/**/*.stl"
      ],
      "roi": {
        "z_plane": {
          "active": false,
          "above_mm": 2.0,
          "below_mm": 12.0
        },
        "outlier_sigma": 3.0
      }
    },
    {
      "id": "SKD_22",
      "skd_mm": 22,
      "file_patterns": [
        "**/SKD 22/*.stl",
        "**/SKD 22/**/*.stl"
      ],
      "roi": {
        "z_plane": {
